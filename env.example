# AI Keys
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=xxx
OPENAI_API_KEY=xxx
ANTHROPIC_API_KEY=xxx

# SMTP Configuration (MXRoute, SendGrid, Gmail SMTP, or any SMTP provider)
SMTP_HOST=mail.mxrouting.net
SMTP_PORT=587
SMTP_USER=agent@yourdomain.com
SMTP_PASS=your_smtp_password
SMTP_FROM=agent@yourdomain.com

# Default LLM model (can be overridden per agent in the dashboard dropdown).
# Anthropic: anthropic/claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5 | claude-fable-5-1
# OpenAI:    openai/gpt-6.1-terra | gpt-6.1-sol | gpt-6-luna | gpt-6-astra
DEFAULT_MODEL=anthropic/claude-opus-5-5

# OpenAI reasoning effort: none | low | medium | high  (default: none)
# gpt-5.x models reason by default, but OpenAI's chat-completions endpoint refuses
# function tools while reasoning is active — and every Charm agent has tools. With
# "none" the agents use chat completions with reasoning disabled (fast, the default).
# Any other value routes gpt-5.x through /v1/responses instead, where tools and
# reasoning coexist, and surfaces reasoning summaries as "think out loud" bubbles.
# Reasoning is SLOW: a hard high-effort call measured ~50s vs ~1.6s with it off, and
# an agent turn makes several calls. Check DASHBOARD_CHAT_TIMEOUT / CHAT_REMOTE_TIMEOUT
# and CHAT_IDLE_LIMIT before enabling. Claude models ignore this setting.
OPENAI_REASONING_EFFORT=none

# Agent conversation tracing: "standard" (operational) or "conversation" (narrative for demos)
AGENT_LOG_LEVEL=conversation

# Port for the web dashboard. startup.sh reads this, and it must match the port in
# TRACE_COLLECTOR_URL below. Avoid ports used by your other local apps — startup.sh
# frees its own ports at launch by killing whatever holds them.
WEB_PORT=9091
# Agents send trace events to the dashboard here, over mutual TLS. The browser stays on WEB_PORT.
# DASHBOARD_TRACE_PORT=9092

# URL where agent processes send trace events to the web dashboard
TRACE_COLLECTOR_URL=https://localhost:9092/api/trace/collect

# Logging
LOG_LEVEL=DEBUG

# For SMS Server
SMS_KEY=xxx
SMS_URL=https://textbelt.com/text

# For Web Agent (browser-use)
# browser-use runs in an ISOLATED venv (.venv-web) — create it with ./setup_web_venv.sh.
# Local headless browsing needs no key. Set BROWSER_USE_API_KEY to enable the
# cloud fallback (stealth browser, residential proxies, CAPTCHA solving) used when
# a site blocks the local browser, or when the user forces the cloud path.
BROWSER_USE_API_KEY=
WEB_AGENT_HEADLESS=true
WEB_AGENT_CLOUD_FALLBACK=true
# Max seconds for a single browsing task (one browse_web call / runner subprocess).
# Cloud (use_cloud) browses run Claude over a remote stealth browser and can take ~5+ min,
# so this cap deliberately cuts them short: a bot-protected site (clock/weather sites are
# usually Cloudflare-protected) would otherwise hold a single request for minutes.
WEB_AGENT_TIMEOUT=120
# Per-request research budget: caps how much the Web Agent can browse before it must answer,
# so its LLM can't loop forever and blow past the chat agent's call timeout. Keep
# (WEB_AGENT_BROWSE_BUDGET + WEB_AGENT_TIMEOUT) safely below CHAT_REMOTE_TIMEOUT.
WEB_AGENT_MAX_BROWSES=3
WEB_AGENT_BROWSE_BUDGET=90
# Optional: override the python used to run web_browser_runner.py (defaults to .venv-web)
# WEB_AGENT_VENV_PYTHON=
# (Deprecated) WEB_AGENT_CLOUD_MODEL is no longer used: the cloud path now drives a stealth
# cloud BROWSER with your local Claude (DEFAULT_MODEL) for reasoning, not a managed cloud model.
# WEB_AGENT_CLOUD_MODEL=
# Optional comma-separated bot-protection markers that trigger the cloud fallback
# WEB_AGENT_BLOCK_MARKERS=captcha,cloudflare,verify you are human,access denied,403 forbidden

# Request timeouts (seconds). MUST satisfy: DASHBOARD_CHAT_TIMEOUT > CHAT_REMOTE_TIMEOUT >
# WEB_AGENT_TIMEOUT. Long because a research+email request can drive several browse_web
# calls plus report composition before replying.
DASHBOARD_CHAT_TIMEOUT=780   # dashboard -> chat agent (outermost; largest)
CHAT_REMOTE_TIMEOUT=720      # chat agent -> a specialist agent (e.g. web/email)

# Chat liveness watchdog (dashboard). The dashboard launches each chat request in the
# background and answers over the SSE stream. A request is killed only if the trace
# stream goes silent (no agent activity) for CHAT_IDLE_LIMIT seconds — active work is
# never interrupted. CHAT_MAX_RUNTIME is a hard backstop against infinite loops.
CHAT_IDLE_LIMIT=90           # seconds of NO agent activity = considered hung
CHAT_MAX_RUNTIME=1200        # absolute ceiling for a single request